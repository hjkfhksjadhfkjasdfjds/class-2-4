<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>2학년 4반 수행평가 스마트폰 알리미</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Noto Sans KR', 'sans-serif'],
                    },
                    keyframes: {
                        shake: {
                            '0%, 100%': { transform: 'translateX(0)' },
                            '20%, 60%': { transform: 'translateX(-8px)' },
                            '40%, 80%': { transform: 'translateX(8px)' }
                        }
                    },
                    animation: {
                        shake: 'shake 0.4s ease-in-out'
                    }
                }
            }
        }
    </script>
    <style>
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        
        body {
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
        }
    </style>
</head>
<body class="bg-slate-900 font-sans text-slate-800 antialiased min-h-screen flex justify-center selection:bg-indigo-500 selection:text-white">

    <!-- FULL-SCREEN ACCESS LOCK SCREEN -->
    <div id="lockScreen" class="fixed inset-0 z-50 bg-slate-950 flex flex-col items-center justify-center p-6 text-white transition-opacity duration-300">
        <div class="absolute -top-12 -left-12 w-64 h-64 bg-indigo-600/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-12 -right-12 w-64 h-64 bg-purple-600/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="w-full max-w-sm space-y-6 text-center z-10">
            <!-- Icon & Welcome Header -->
            <div class="space-y-3">
                <div class="w-20 h-20 bg-gradient-to-tr from-indigo-500 to-purple-600 rounded-3xl flex items-center justify-center mx-auto shadow-2xl shadow-indigo-500/30 border border-white/10">
                    <i class="fa-solid fa-lock text-3xl text-white"></i>
                </div>
                <div>
                    <span class="inline-block bg-indigo-500/20 text-indigo-300 font-bold text-xs px-3 py-1 rounded-full border border-indigo-500/30 mb-2">
                        2학년 4반 학급 전용
                    </span>
                    <h1 class="text-2xl font-black text-white tracking-tight">수행평가 알리미</h1>
                    <p class="text-xs text-slate-400 mt-1">학급원 전용 보안 시스템입니다.<br>접속 비밀번호를 입력해주세요.</p>
                </div>
            </div>

            <!-- Lock Form -->
            <form onsubmit="handleUnlock(event)" id="lockForm" class="space-y-4 pt-2">
                <div class="relative">
                    <input type="password" id="lockPasswordInput" required placeholder="비밀번호 입력"
                        class="w-full h-14 pl-11 pr-4 bg-slate-900/90 border border-slate-700 rounded-2xl text-sm font-semibold text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/50 transition">
                    <i class="fa-solid fa-key absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm"></i>
                </div>

                <p id="lockErrorMsg" class="hidden text-rose-400 font-extrabold text-xs flex items-center justify-center animate-shake">
                    <i class="fa-solid fa-circle-exclamation mr-1.5"></i>비밀번호가 올바르지 않습니다.
                </p>

                <button type="submit" class="w-full h-14 bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 active:scale-[0.98] text-white font-extrabold rounded-2xl shadow-xl shadow-indigo-600/30 text-sm transition flex items-center justify-center space-x-2">
                    <i class="fa-solid fa-unlock text-xs"></i>
                    <span>2학년 4반 입장하기</span>
                </button>
            </form>

            <p class="text-[11px] text-slate-500 pt-4">
                비밀번호를 모르시는 경우 부반장에게 문의하세요.
            </p>
        </div>
    </div>

    <!-- MAIN MOBILE APP CONTAINER -->
    <div id="appContainer" class="w-full max-w-md bg-slate-50 min-h-screen shadow-2xl flex flex-col relative pb-24 hidden">
        
        <!-- STICKY MOBILE TOP HEADER -->
        <header class="bg-white border-b border-slate-200 sticky top-0 z-30 px-4 py-3 shadow-sm">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2.5">
                    <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-600 to-purple-600 flex items-center justify-center text-white shadow-md shadow-indigo-500/20">
                        <i class="fa-solid fa-graduation-cap text-base"></i>
                    </div>
                    <div>
                        <div class="flex items-center space-x-1.5">
                            <h1 id="headerClassName" class="font-extrabold text-slate-900 text-base leading-tight">2학년 4반</h1>
                            <span class="text-[10px] bg-emerald-100 text-emerald-700 font-bold px-1.5 py-0.2 rounded-md flex items-center">
                                <i class="fa-solid fa-circle-check mr-1 text-[9px]"></i>인증됨
                            </span>
                        </div>
                        <p class="text-[11px] text-slate-400 font-medium" id="headerTodayDate">----.--.-- (-)</p>
                    </div>
                </div>

                <!-- Header Action Buttons -->
                <div class="flex items-center space-x-1.5">
                    <button onclick="openModal()" class="inline-flex items-center px-3 py-2 bg-indigo-600 hover:bg-indigo-700 active:scale-95 text-white rounded-xl text-xs font-bold transition shadow-sm">
                        <i class="fa-solid fa-plus mr-1"></i> 과제추가
                    </button>
                </div>
            </div>
        </header>

        <!-- MAIN CONTENT AREA -->
        <main class="flex-1 px-4 py-4 space-y-4">

            <!-- MOBILE SUMMARY BANNER CARD -->
            <div class="bg-slate-900 text-white rounded-2xl p-4 shadow-lg relative overflow-hidden">
                <div class="absolute -right-6 -bottom-6 w-32 h-32 bg-indigo-500/20 rounded-full blur-2xl pointer-events-none"></div>
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-bold text-indigo-300 flex items-center">
                        <i class="fa-solid fa-bolt mr-1.5 text-yellow-400"></i> 진행 중인 과제 현황
                    </span>
                    <span class="text-[10px] text-emerald-400 font-semibold bg-emerald-950/60 px-2 py-0.5 rounded-full border border-emerald-800/50">
                        <i class="fa-solid fa-rotate mr-1 animate-spin"></i>실시간 연동중
                    </span>
                </div>

                <div class="grid grid-cols-3 gap-2 bg-white/10 backdrop-blur-md p-2.5 rounded-xl text-center border border-white/10">
                    <div>
                        <span class="block text-xl font-extrabold text-red-400" id="statTodayCount">0</span>
                        <span class="text-[10px] text-slate-300">오늘 마감</span>
                    </div>
                    <div class="border-x border-white/10">
                        <span class="block text-xl font-extrabold text-amber-400" id="statUrgentCount">0</span>
                        <span class="text-[10px] text-slate-300">임박 (D-3)</span>
                    </div>
                    <div>
                        <span class="block text-xl font-extrabold text-emerald-400" id="statMyDoneCount">0</span>
                        <span class="text-[10px] text-slate-300">내 완료</span>
                    </div>
                </div>
            </div>

            <!-- SEARCH & FILTER BAR -->
            <div class="space-y-2.5">
                <div class="relative">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input type="text" id="searchInput" oninput="renderAssignments()" placeholder="과목명, 과제 제목 검색..."
                        class="w-full pl-9 pr-8 py-2.5 bg-white border border-slate-200 rounded-xl text-xs font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 shadow-sm transition">
                    <button onclick="clearSearch()" id="clearSearchBtn" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600">
                        <i class="fa-solid fa-xmark text-xs"></i>
                    </button>
                </div>

                <!-- Horizontal Scroll Subject Pills -->
                <div class="flex items-center gap-1.5 overflow-x-auto pb-1 no-scrollbar text-xs" id="subjectFilterContainer">
                    <!-- Dynamic subject buttons rendered by JS -->
                </div>
            </div>

            <!-- ASSIGNMENT CARD LIST -->
            <div id="assignmentList" class="space-y-3">
                <!-- Dynamic Cards Injected by JS -->
            </div>

            <!-- EMPTY STATE -->
            <div id="emptyState" class="hidden bg-white rounded-2xl p-8 text-center border border-dashed border-slate-300 my-4 space-y-2">
                <div class="w-12 h-12 bg-indigo-50 text-indigo-500 rounded-2xl flex items-center justify-center mx-auto text-xl">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>
                <h3 class="text-sm font-bold text-slate-800">등록된 수행평가가 없습니다!</h3>
                <p class="text-xs text-slate-400">마감된 과제는 자정에 자동 숨김 처리되며, 오른쪽 아래 + 버튼을 눌러 유인물 사진과 과제를 등록해 보세요.</p>
            </div>

        </main>

        <!-- FLOATING ACTION BUTTON (FAB) -->
        <button onclick="openModal()" class="fixed bottom-6 right-6 sm:right-[calc(50vw-200px)] w-14 h-14 bg-indigo-600 hover:bg-indigo-700 active:scale-90 text-white rounded-full shadow-2xl flex items-center justify-center text-xl z-40 transition-transform shadow-indigo-500/40">
            <i class="fa-solid fa-plus"></i>
        </button>

    </div>

    <!-- CREATE TASK MODAL WITH IMAGE ATTACHMENT -->
    <div id="taskModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-end justify-center hidden transition-opacity opacity-0 duration-200">
        <div class="bg-white rounded-t-3xl shadow-2xl w-full max-w-md p-5 max-h-[90vh] overflow-y-auto transform translate-y-full transition-transform duration-200 space-y-4" id="modalContent">
            
            <div class="flex items-center justify-between border-b pb-3">
                <div class="flex items-center space-x-2">
                    <i class="fa-solid fa-pen-clip text-indigo-600"></i>
                    <h3 class="font-extrabold text-slate-900 text-sm">새 수행평가/과제 등록</h3>
                </div>
                <button onclick="closeModal()" class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 active:bg-slate-200">
                    <i class="fa-solid fa-xmark text-sm"></i>
                </button>
            </div>

            <form id="assignmentForm" onsubmit="handleFormSubmit(event)" class="space-y-3 text-xs">
                <!-- Subject & Type -->
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">과목 <span class="text-red-500">*</span></label>
                        <select id="taskSubject" required class="w-full min-h-[44px] px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl font-medium focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                            <option value="국어">국어</option>
                            <option value="수학">수학</option>
                            <option value="영어">영어</option>
                            <option value="한국사">한국사</option>
                            <option value="사회탐구">사회탐구</option>
                            <option value="과학탐구">과학탐구</option>
                            <option value="예체능">예체능</option>
                            <option value="정보/기타">정보/기타</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">유형 <span class="text-red-500">*</span></label>
                        <select id="taskType" required class="w-full min-h-[44px] px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl font-medium focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                            <option value="수행평가">수행평가 📝</option>
                            <option value="지필평가">지필평가 ✍️</option>
                            <option value="팀프로젝트">팀프로젝트 👥</option>
                            <option value="일반과제">일반과제 📚</option>
                            <option value="준비물/공지">준비물/공지 🎒</option>
                        </select>
                    </div>
                </div>

                <!-- Title -->
                <div>
                    <label class="block font-bold text-slate-700 mb-1">과제 / 수행평가 제목 <span class="text-red-500">*</span></label>
                    <input type="text" id="taskTitle" required placeholder="예: 현대시 분석 보고서 제출"
                        class="w-full min-h-[44px] px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl font-medium focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                </div>

                <!-- Due Date & Time -->
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">마감 날짜 <span class="text-red-500">*</span></label>
                        <input type="date" id="taskDueDate" required class="w-full min-h-[44px] px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl font-medium focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">마감 시간 / 교시</label>
                        <input type="text" id="taskDueTime" placeholder="예: 5교시 전, 23:59" class="w-full min-h-[44px] px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl font-medium focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                    </div>
                </div>

                <!-- Image Attachment File Picker -->
                <div>
                    <label class="block font-bold text-slate-700 mb-1">
                        <i class="fa-regular fa-image text-indigo-600 mr-1"></i>유인물 / 프린트 사진 첨부
                    </label>
                    <div class="flex items-center space-x-2">
                        <label for="taskImageInput" class="flex-1 cursor-pointer bg-slate-50 border border-slate-200 hover:bg-slate-100 rounded-xl p-2.5 text-center font-medium text-slate-600 transition flex items-center justify-center space-x-2">
                            <i class="fa-solid fa-camera text-indigo-500"></i>
                            <span id="imageInputLabelText">사진 촬영 또는 갤러리 선택</span>
                        </label>
                        <input type="file" id="taskImageInput" accept="image/*" multiple class="hidden" onchange="handleImageSelect(event)">
                    </div>

                    <!-- Image Preview Container -->
                    <div id="imagePreviewContainer" class="hidden mt-2 relative bg-slate-100 rounded-xl p-2 border border-slate-200 text-center">
                        <div id="imagePreview" class="grid grid-cols-3 gap-2"></div>
                        <button type="button" onclick="removeSelectedImage()" class="absolute top-3 right-3 bg-red-600 text-white w-7 h-7 rounded-full flex items-center justify-center shadow-md active:scale-95">
                            <i class="fa-solid fa-xmark text-xs"></i>
                        </button>
                        <p class="text-[10px] text-slate-400 mt-1">자동 압축되어 데이터가 절약됩니다.</p>
                    </div>
                </div>

                <!-- Description -->
                <div>
                    <label class="block font-bold text-slate-700 mb-1">제출 방식 및 세부 설명</label>
                    <textarea id="taskDescription" rows="2" placeholder="예: 교무실 앞 제출함 제출, 분량 A4 2장 내외 등"
                        class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl font-medium focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none resize-none"></textarea>
                </div>

                <!-- Author & Priority -->
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">작성자</label>
                        <input type="text" id="taskAuthor" placeholder="예: 부반장" class="w-full min-h-[44px] px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl font-medium focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">중요도</label>
                        <select id="taskPriority" class="w-full min-h-[44px] px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl font-medium focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                            <option value="normal">보통 🔵</option>
                            <option value="important">중요 ⚡</option>
                            <option value="urgent">필수 제출 🚨</option>
                        </select>
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="pt-2 flex space-x-2">
                    <button type="button" onclick="closeModal()" class="w-1/3 min-h-[44px] py-2.5 border border-slate-200 text-slate-600 rounded-xl font-semibold active:bg-slate-100">
                        취소
                    </button>
                    <button type="submit" id="submitBtn" class="w-2/3 min-h-[44px] py-2.5 bg-indigo-600 text-white rounded-xl font-bold shadow-md shadow-indigo-500/20 active:bg-indigo-700 flex items-center justify-center space-x-1">
                        <span>게시판에 등록하기</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- FULLSCREEN IMAGE VIEWER MODAL -->
    <div id="imageViewerModal" class="fixed inset-0 bg-black/90 backdrop-blur-md z-50 flex flex-col items-center justify-between p-4 hidden transition-opacity opacity-0 duration-200">
        <div class="w-full flex justify-end">
            <button onclick="closeImageViewer()" class="w-10 h-10 bg-white/20 hover:bg-white/30 text-white rounded-full flex items-center justify-center text-lg active:scale-90 transition">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="flex-1 w-full flex items-center justify-center p-2 overflow-auto">
            <img id="imageViewerImg" src="" alt="유인물 사진 크게 보기" class="max-w-full max-h-[80vh] object-contain rounded-xl shadow-2xl">
        </div>
        <p class="text-xs text-slate-400 mb-2">손가락으로 화면을 두 번 터치하거나 핀치하여 확대할 수 있습니다.</p>
    </div>

    <!-- CUSTOM DELETE CONFIRMATION MODAL -->
    <div id="deleteConfirmModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden transition-opacity opacity-0 duration-200">
        <div class="bg-white rounded-2xl shadow-2xl max-w-xs w-full p-5 text-center space-y-3">
            <div class="w-12 h-12 bg-red-100 text-red-600 rounded-2xl flex items-center justify-center mx-auto text-xl">
                <i class="fa-regular fa-trash-can"></i>
            </div>
            <div>
                <h3 class="font-bold text-slate-900 text-sm">과제를 지우시겠습니까?</h3>
                <p class="text-xs text-slate-500 mt-1 leading-snug" id="deleteModalTaskTitle">선택한 수행평가가 삭제됩니다.</p>
            </div>

            <div class="flex items-center justify-center space-x-2 pt-2">
                <button onclick="closeDeleteModal()" class="w-1/2 min-h-[44px] py-2 border border-slate-200 text-slate-700 font-semibold rounded-xl text-xs active:bg-slate-50">
                    취소
                </button>
                <button onclick="executeDeleteTask()" class="w-1/2 min-h-[44px] py-2 bg-red-600 text-white font-bold rounded-xl shadow-md shadow-red-500/20 text-xs active:bg-red-700">
                    삭제하기
                </button>
            </div>
        </div>
    </div>

    <!-- JAVASCRIPT & FIREBASE INTEGRATION -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, doc, addDoc, deleteDoc, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        const CLASS_PASSWORD = "1234204";
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'class-2-4-mobile-dashboard';
        let db = null;
        let auth = null;
        let isFirebaseAvailable = false;

        let assignments = [];
        let currentFilter = 'ALL';
        let targetDeleteId = null;
        let selectedBase64Images = [];
        let myCheckedTaskIds = JSON.parse(localStorage.getItem('my_checked_tasks_2_4') || '[]');
        
        const className = '2학년 4반';

        // Subject Badges Styling Map
        const SUBJECT_CONFIG = {
            'ALL': { label: '전체 보기', bg: 'bg-slate-900 text-white' },
            '수행평가': { label: '📝 수행평가', filterType: 'type', bg: 'bg-indigo-100 text-indigo-700' },
            '국어': { label: '국어', bg: 'bg-rose-100 text-rose-700' },
            '수학': { label: '수학', bg: 'bg-blue-100 text-blue-700' },
            '영어': { label: '영어', bg: 'bg-violet-100 text-violet-700' },
            '한국사': { label: '한국사', bg: 'bg-amber-100 text-amber-800' },
            '사회탐구': { label: '사탐', bg: 'bg-orange-100 text-orange-700' },
            '과학탐구': { label: '과탐', bg: 'bg-emerald-100 text-emerald-700' },
            '예체능': { label: '예체능', bg: 'bg-purple-100 text-purple-700' },
            '정보/기타': { label: '기타', bg: 'bg-teal-100 text-teal-700' }
        };

        window.handleUnlock = function(event) {
            event.preventDefault();
            const inputVal = document.getElementById('lockPasswordInput').value;
            const errorMsg = document.getElementById('lockErrorMsg');

            if (inputVal === CLASS_PASSWORD) {
                sessionStorage.setItem('class_2_4_authenticated', 'true');
                unlockAppUI();
            } else {
                errorMsg.classList.remove('hidden');
                document.getElementById('lockPasswordInput').classList.add('border-rose-500');
                setTimeout(() => {
                    document.getElementById('lockPasswordInput').classList.remove('border-rose-500');
                }, 1000);
            }
        };

        function checkAuthStatus() {
            const isAuth = sessionStorage.getItem('class_2_4_authenticated') === 'true';
            if (isAuth) {
                unlockAppUI();
            } else {
                showLockScreen();
            }
        }

        function unlockAppUI() {
            const lockScreen = document.getElementById('lockScreen');
            const appContainer = document.getElementById('appContainer');

            lockScreen.classList.add('opacity-0');
            setTimeout(() => {
                lockScreen.classList.add('hidden');
                appContainer.classList.remove('hidden');
            }, 300);

            initApp();
        }

        window.lockApp = function() {
            sessionStorage.removeItem('class_2_4_authenticated');
            showLockScreen();
        };

        function showLockScreen() {
            const lockScreen = document.getElementById('lockScreen');
            const appContainer = document.getElementById('appContainer');
            
            document.getElementById('lockPasswordInput').value = '';
            document.getElementById('lockErrorMsg').classList.add('hidden');

            appContainer.classList.add('hidden');
            lockScreen.classList.remove('hidden');
            setTimeout(() => {
                lockScreen.classList.remove('opacity-0');
            }, 10);
        }

        async function initApp() {
            updateHeaderInfo();
            renderFilterTabs();

            // Auto check every minute to hide expired tasks
            setInterval(() => {
                updateHeaderInfo();
                renderAssignments();
            }, 60000);

            if (typeof __firebase_config !== 'undefined' && __firebase_config) {
                try {
                    const firebaseConfig = JSON.parse(__firebase_config);
                    const app = initializeApp(firebaseConfig);
                    auth = getAuth(app);
                    db = getFirestore(app);

                    if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                        await signInWithCustomToken(auth, __initial_auth_token);
                    } else {
                        await signInAnonymously(auth);
                    }

                    // Firestore Collection path
                    const assignmentsCol = collection(db, 'artifacts', appId, 'public', 'data', 'assignments');

                    onSnapshot(assignmentsCol, (snapshot) => {
                        assignments = snapshot.docs.map(doc => ({
                            id: doc.id,
                            ...doc.data()
                        }));
                        renderAssignments();
                    }, (error) => {
                        console.warn("Firestore access error, using local fallback:", error);
                        loadFromLocalFallback();
                    });

                    isFirebaseAvailable = true;
                } catch (err) {
                    console.warn("Firebase setup failed, using local fallback:", err);
                    loadFromLocalFallback();
                }
            } else {
                loadFromLocalFallback();
            }
        }

        function loadFromLocalFallback() {
            const saved = localStorage.getItem('local_2_4_assignments');
            if (saved) {
                try { assignments = JSON.parse(saved); } 
                catch (e) { assignments = []; }
            } else {
                assignments = [];
                saveToLocalStorage();
            }
            renderAssignments();
        }

        function saveToLocalStorage() {
            localStorage.setItem('local_2_4_assignments', JSON.stringify(assignments));
        }

        /**
         * Calculates D-Day status and checks if task has expired (past due date).
         */
        function getDDayStatus(dueDateStr) {
            const today = new Date();
            today.setHours(0, 0, 0, 0);

            const target = new Date(dueDateStr);
            target.setHours(0, 0, 0, 0);

            const diffTime = target.getTime() - today.getTime();
            const diffDays = Math.round(diffTime / (1000 * 60 * 60 * 24));

            if (diffDays < 0) {
                return {
                    label: '기한 지남',
                    days: diffDays,
                    isExpired: true,
                    badgeClass: 'bg-slate-200 text-slate-500 font-semibold',
                    urgency: 'expired'
                };
            } else if (diffDays === 0) {
                return {
                    label: 'D-DAY 오늘!',
                    days: 0,
                    isExpired: false,
                    badgeClass: 'bg-red-600 text-white font-extrabold ring-2 ring-red-300 animate-pulse',
                    urgency: 'critical'
                };
            } else if (diffDays <= 3) {
                return {
                    label: `D-${diffDays}`,
                    days: diffDays,
                    isExpired: false,
                    badgeClass: 'bg-rose-500 text-white font-bold',
                    urgency: 'high'
                };
            } else if (diffDays <= 7) {
                return {
                    label: `D-${diffDays}`,
                    days: diffDays,
                    isExpired: false,
                    badgeClass: 'bg-amber-500 text-white font-bold',
                    urgency: 'medium'
                };
            } else {
                return {
                    label: `D-${diffDays}`,
                    days: diffDays,
                    isExpired: false,
                    badgeClass: 'bg-indigo-600 text-white font-medium',
                    urgency: 'normal'
                };
            }
        }

        /**
         * Compresses selected image to max 800px width/height and JPEG format.
         */
        function compressImage(file, maxWidth = 800, quality = 0.7) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.readAsDataURL(file);
                reader.onload = (event) => {
                    const img = new Image();
                    img.src = event.target.result;
                    img.onload = () => {
                        const canvas = document.createElement('canvas');
                        let width = img.width;
                        let height = img.height;

                        if (width > height) {
                            if (width > maxWidth) {
                                height = Math.round((height * maxWidth) / width);
                                width = maxWidth;
                            }
                        } else {
                            if (height > maxWidth) {
                                width = Math.round((width * maxWidth) / height);
                                height = maxWidth;
                            }
                        }

                        canvas.width = width;
                        canvas.height = height;

                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0, width, height);

                        const dataUrl = canvas.toDataURL('image/jpeg', quality);
                        resolve(dataUrl);
                    };
                    img.onerror = (err) => reject(err);
                };
                reader.onerror = (err) => reject(err);
            });
        }

        window.handleImageSelect = async function(event) {
            const files = Array.from(event.target.files || []);
            if (!files.length) return;

            const labelText = document.getElementById('imageInputLabelText');
            labelText.textContent = '사진 압축 처리 중...';

            try {
                const images = await Promise.all(files.map(file => compressImage(file, 800, 0.7)));
                selectedBase64Images = selectedBase64Images.concat(images);
                document.getElementById('imagePreview').innerHTML = selectedBase64Images.map((src, index) => `
                    <div class="relative"><img src="${src}" alt="미리보기 ${index + 1}" class="w-full h-24 rounded-lg object-cover shadow-sm">
                    <button type="button" onclick="removeSelectedImage(${index})" class="absolute top-1 right-1 bg-red-600 text-white w-6 h-6 rounded-full">×</button></div>
                `).join('');
                document.getElementById('imagePreviewContainer').classList.remove('hidden');
                labelText.textContent = '사진 추가하기';
            } catch (err) {
                console.error("Image compression error:", err);
                labelText.textContent = '사진 촬영 또는 갤러리 선택';
            }
        };

        window.removeSelectedImage = function(index = null) {
            if (index !== null) selectedBase64Images.splice(index, 1);
            else selectedBase64Images = [];
            document.getElementById('taskImageInput').value = '';
            document.getElementById('imagePreview').innerHTML = selectedBase64Images.map((src, i) => `
                <div class="relative"><img src="${src}" alt="미리보기 ${i + 1}" class="w-full h-24 rounded-lg object-cover shadow-sm">
                <button type="button" onclick="removeSelectedImage(${i})" class="absolute top-1 right-1 bg-red-600 text-white w-6 h-6 rounded-full">×</button></div>
            `).join('');
            if (!selectedBase64Images.length) {
                document.getElementById('imagePreviewContainer').classList.add('hidden');
                document.getElementById('imageInputLabelText').textContent = '사진 여러 장 선택';
            }
        };

        function renderFilterTabs() {
            const container = document.getElementById('subjectFilterContainer');
            container.innerHTML = Object.keys(SUBJECT_CONFIG).map(key => {
                const cfg = SUBJECT_CONFIG[key];
                const isActive = currentFilter === key;
                const activeClass = isActive 
                    ? 'bg-slate-900 text-white shadow-sm font-bold' 
                    : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200';

                return `
                    <button onclick="setFilter('${key}')" class="px-3 py-1.5 rounded-xl text-xs transition whitespace-nowrap ${activeClass}">
                        ${cfg.label}
                    </button>
                `;
            }).join('');
        }

        window.setFilter = function(key) {
            currentFilter = key;
            renderFilterTabs();
            renderAssignments();
        };

        window.clearSearch = function() {
            document.getElementById('searchInput').value = '';
            document.getElementById('clearSearchBtn').classList.add('hidden');
            renderAssignments();
        };

        window.renderAssignments = function() {
            const listContainer = document.getElementById('assignmentList');
            const emptyState = document.getElementById('emptyState');
            const searchVal = document.getElementById('searchInput').value.trim().toLowerCase();
            const clearBtn = document.getElementById('clearSearchBtn');

            if (searchVal) clearBtn.classList.remove('hidden');
            else clearBtn.classList.add('hidden');

            // Filter out expired tasks automatically (마감일 지난 25일 00시 이후 자동 숨김)
            let activeTasks = assignments.filter(item => {
                const status = getDDayStatus(item.dueDate);
                return !status.isExpired;
            });

            // Apply subject & search filters
            let filtered = activeTasks.filter(item => {
                if (currentFilter !== 'ALL') {
                    if (currentFilter === '수행평가' && item.type !== '수행평가') return false;
                    if (currentFilter !== '수행평가' && item.subject !== currentFilter) return false;
                }

                if (searchVal) {
                    const matchTitle = (item.title || '').toLowerCase().includes(searchVal);
                    const matchSubj = (item.subject || '').toLowerCase().includes(searchVal);
                    const matchDesc = (item.description || '').toLowerCase().includes(searchVal);
                    if (!matchTitle && !matchSubj && !matchDesc) return false;
                }

                return true;
            });

            // Sort: Impending/D-day at top
            filtered.sort((a, b) => {
                const statusA = getDDayStatus(a.dueDate);
                const statusB = getDDayStatus(b.dueDate);
                return statusA.days - statusB.days;
            });

            updateStats(activeTasks);

            if (filtered.length === 0) {
                listContainer.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');
            listContainer.innerHTML = filtered.map(item => createMobileCardHTML(item)).join('');
        };

        function createMobileCardHTML(item) {
            const dday = getDDayStatus(item.dueDate);
            const isChecked = myCheckedTaskIds.includes(item.id);
            const subjConfig = SUBJECT_CONFIG[item.subject] || { bg: 'bg-slate-100 text-slate-700' };
            const itemImages = Array.isArray(item.imageData) ? item.imageData : (item.imageData ? [item.imageData] : []);

            return `
                <div class="bg-white rounded-2xl p-4 border ${isChecked ? 'border-emerald-300 bg-emerald-50/20' : 'border-slate-200'} shadow-sm space-y-2.5 relative transition">
                    
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-1.5">
                            <span class="px-2 py-0.5 rounded-md text-[11px] font-bold ${subjConfig.bg}">
                                ${item.subject}
                            </span>
                            <span class="text-[11px] text-slate-500 font-medium bg-slate-100 px-1.5 py-0.5 rounded-md">
                                ${item.type || '수행'}
                            </span>
                        </div>
                        <span class="px-2.5 py-0.5 rounded-full text-[11px] ${dday.badgeClass}">
                            ${dday.label}
                        </span>
                    </div>

                    <div>
                        <h3 class="font-extrabold text-slate-900 text-sm leading-snug ${isChecked ? 'line-through text-slate-400' : ''}">
                            ${escapeHTML(item.title)}
                        </h3>
                        <p class="text-[11px] text-slate-500 mt-1 flex items-center">
                            <i class="fa-regular fa-clock mr-1 text-slate-400"></i>
                            <span class="font-semibold text-slate-700 mr-1">${item.dueDate}</span>
                            ${item.dueTime ? `(${escapeHTML(item.dueTime)})` : ''}
                        </p>
                    </div>

                    ${itemImages.length ? `
                        <div class="grid grid-cols-2 gap-2 rounded-xl overflow-hidden border border-slate-200 bg-slate-100 p-1 cursor-pointer" onclick="openImageViewer('${item.id}')">
                            ${itemImages.map((src, index) => `<img src="${src}" alt="유인물 ${index + 1}" class="w-full h-36 object-cover rounded-lg">`).join('')}
                            <div class="absolute inset-0 bg-slate-900/30 flex items-center justify-center opacity-90 transition">
                                <span class="bg-slate-900/80 text-white text-[10px] font-bold px-2.5 py-1 rounded-full backdrop-blur-md flex items-center space-x-1">
                                    <i class="fa-solid fa-magnifying-glass-plus"></i>
                                    <span>유인물 크게 보기</span>
                                </span>
                            </div>
                        </div>
                    ` : ''}

                    ${item.description ? `
                        <div class="bg-slate-50 p-2.5 rounded-xl border border-slate-100 text-[11px] text-slate-600 leading-relaxed whitespace-pre-wrap">
                            ${escapeHTML(item.description)}
                        </div>
                    ` : ''}

                    <div class="pt-1 flex items-center justify-between text-xs">
                        <button onclick="toggleTaskCheck('${item.id}')" class="min-h-[40px] px-3 py-1.5 rounded-xl flex items-center space-x-1.5 font-bold transition ${isChecked ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-600 active:bg-slate-200'}">
                            <i class="fa-${isChecked ? 'solid text-emerald-600' : 'regular text-slate-400'} fa-circle-check text-sm"></i>
                            <span>${isChecked ? '제출 완료' : '내 완료 체크'}</span>
                        </button>

                        <button onclick="askDeleteTask('${item.id}')" class="w-9 h-9 rounded-xl flex items-center justify-center text-slate-400 hover:text-red-600 active:bg-red-50 transition" title="삭제">
                            <i class="fa-regular fa-trash-can text-sm"></i>
                        </button>
                    </div>
                </div>
            `;
        }

        window.openImageViewer = function(taskId) {
            const task = assignments.find(a => a.id === taskId);
            const images = task && (Array.isArray(task.imageData) ? task.imageData : (task.imageData ? [task.imageData] : []));
            if (!images.length) return;

            document.getElementById('imageViewerImg').src = images[0];
            const modal = document.getElementById('imageViewerModal');
            modal.classList.remove('hidden');
            setTimeout(() => modal.classList.remove('opacity-0'), 10);
        };

        window.closeImageViewer = function() {
            const modal = document.getElementById('imageViewerModal');
            modal.classList.add('opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
                document.getElementById('imageViewerImg').src = '';
            }, 200);
        };

        function updateStats(activeTasks) {
            let todayCount = 0;
            let urgentCount = 0;

            activeTasks.forEach(item => {
                const status = getDDayStatus(item.dueDate);
                if (status.days === 0) todayCount++;
                if (status.days > 0 && status.days <= 3) urgentCount++;
            });

            const activeChecked = myCheckedTaskIds.filter(id => activeTasks.some(t => t.id === id));

            document.getElementById('statTodayCount').textContent = todayCount;
            document.getElementById('statUrgentCount').textContent = urgentCount;
            document.getElementById('statMyDoneCount').textContent = activeChecked.length;
        }

        window.openModal = function() {
            document.getElementById('assignmentForm').reset();
            removeSelectedImage();

            const today = new Date().toISOString().split('T')[0];
            document.getElementById('taskDueDate').value = today;

            const modal = document.getElementById('taskModal');
            const content = document.getElementById('modalContent');
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                content.classList.remove('translate-y-full');
            }, 10);
        };

        window.closeModal = function() {
            const modal = document.getElementById('taskModal');
            const content = document.getElementById('modalContent');
            modal.classList.add('opacity-0');
            content.classList.add('translate-y-full');
            setTimeout(() => modal.classList.add('hidden'), 200);
        };

        window.handleFormSubmit = async function(event) {
            event.preventDefault();

            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = true;
            submitBtn.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i> <span>업로드 중...</span>`;

            const subject = document.getElementById('taskSubject').value;
            const type = document.getElementById('taskType').value;
            const title = document.getElementById('taskTitle').value.trim();
            const dueDate = document.getElementById('taskDueDate').value;
            const dueTime = document.getElementById('taskDueTime').value.trim();
            const description = document.getElementById('taskDescription').value.trim();
            const author = document.getElementById('taskAuthor').value.trim() || '부반장';
            const priority = document.getElementById('taskPriority').value;

            const newTask = {
                subject,
                type,
                title,
                dueDate,
                dueTime,
                description,
                author,
                priority,
                imageData: selectedBase64Images,
                createdAt: Date.now()
            };

            try {
                if (isFirebaseAvailable && db) {
                    const col = collection(db, 'artifacts', appId, 'public', 'data', 'assignments');
                    await addDoc(col, newTask);
                } else {
                    assignments.unshift({ id: 'local-' + Date.now(), ...newTask });
                    saveToLocalStorage();
                    renderAssignments();
                }
            } catch (e) {
                console.error("Save error:", e);
                assignments.unshift({ id: 'local-' + Date.now(), ...newTask });
                saveToLocalStorage();
                renderAssignments();
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = `<span>게시판에 등록하기</span>`;
                closeModal();
            }
        };

        window.askDeleteTask = function(id) {
            const item = assignments.find(a => a.id === id);
            if (!item) return;

            targetDeleteId = id;
            document.getElementById('deleteModalTaskTitle').textContent = `"${item.title}" 항목을 삭제합니다.`;

            const modal = document.getElementById('deleteConfirmModal');
            modal.classList.remove('hidden');
            setTimeout(() => modal.classList.remove('opacity-0'), 10);
        };

        window.closeDeleteModal = function() {
            targetDeleteId = null;
            const modal = document.getElementById('deleteConfirmModal');
            modal.classList.add('opacity-0');
            setTimeout(() => modal.classList.add('hidden'), 200);
        };

        window.executeDeleteTask = async function() {
            if (!targetDeleteId) return;

            const id = targetDeleteId;
            closeDeleteModal();

            if (isFirebaseAvailable && db) {
                try {
                    const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'assignments', id);
                    await deleteDoc(docRef);
                } catch (e) {
                    assignments = assignments.filter(a => a.id !== id);
                    saveToLocalStorage();
                    renderAssignments();
                }
            } else {
                assignments = assignments.filter(a => a.id !== id);
                saveToLocalStorage();
                renderAssignments();
            }
        };

        window.toggleTaskCheck = function(id) {
            const idx = myCheckedTaskIds.indexOf(id);
            if (idx > -1) myCheckedTaskIds.splice(idx, 1);
            else myCheckedTaskIds.push(id);

            localStorage.setItem('my_checked_tasks_2_4', JSON.stringify(myCheckedTaskIds));
            renderAssignments();
        };

        function updateHeaderInfo() {
            document.getElementById('headerClassName').textContent = className;
            const now = new Date();
            const days = ['일', '월', '화', '수', '목', '금', '토'];
            const formatted = `${now.getFullYear()}.${String(now.getMonth()+1).padStart(2,'0')}.${String(now.getDate()).padStart(2,'0')} (${days[now.getDay()]})`;
            document.getElementById('headerTodayDate').textContent = formatted;
        }

        function escapeHTML(str) {
            if (!str) return '';
            return str.replace(/[&<>'"]/g, tag => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
            }[tag] || tag));
        }

        window.addEventListener('DOMContentLoaded', checkAuthStatus);
    </script>
</body>
